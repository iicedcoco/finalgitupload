</value><value name="text"><shadow type="text" id="hJ8lN%(3RJEpOV=eK_oB"><field name="TEXT">Ah, by the way sir, I wanted to ask what you thought about AI?</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="LuN=*B-V^5ZTlAm5nQ2?"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="aYSQ].|/Ln_uR3=H$;h4"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="RXmfk1~4rHW]K%L/O1Xv"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="gw7zd8dGo$Ddv3Q*7[K0"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id="0K4;ES.?i.AhX+H^)qds"><field name="TEXT">Why thank you! AI? Well that can be a heavy topic, why do you ask?</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="KNu?{E]l$b`L8|~3~RqB"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="XW5fd@$TkxX_`6~ttL3l"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id=";$hw^7R/w#XSe}B:N)v+"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="4r:;c/(ih/WXk/*}4j8B"><field name="VAR" id="KW/QBW*o]x9WQ)(y9Zg$">mySprite</field></block></value><value name="text"><shadow type="text" id="_N}s/aA#VBfd[)[0M[`I"><field name="TEXT">I spoke to the librarian and she told me why the books are getting packed up</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="?P+xVq~$}eWqO`RWq(Ba"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="Y18*HuP8QTcOd3iYDSfu"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="R=tT[~Rbjx7!z?H8WO5M"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="dHT@PEh/}E2}iqX5Dxy2"><field name="VAR" id="KW/QBW*o]x9WQ)(y9Zg$">mySprite</field></block></value><value name="text"><shadow type="text" id="fcJq6f`t[BK-1sTop_.N"><field name="TEXT">But when I spoke to the other teachers, they all seemed happy about AI in school</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="rj2oWL^8xV_Yavm/DHpz"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="`}!H=+%U=bE0[olkYPD("><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="n_ne^yi}2WA=a_^X6o@|"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="Mh@$/-H!o]OE8ubR{,xf"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id="n}w|Aa[X^DGPc|L,B?x~"><field name="TEXT">Haha, I'm not sure why you sound upset at that</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="#Vu7w+~V%#y^VNhm(Oex"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="w7GO!n$99bjuU6%;L75T"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="tDBR05}I2a61vxXH6v@`"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="xp4ZAC`z=YPI1IZs(:):"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id=";pi@Tsjdp@di(eZS(F92"><field name="TEXT">Well I can see that it's something you are not happy about</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="(#$VPCxAS5b;o}WGr6Jv"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="ibnc6bir*^-3-[arpfML"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="@ODe1,xX4JuD,fP%yEG4"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="uxg8X=K8QS]mu%u)Td@D"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id="T;:WT]pOF9Lype@oM^wP"><field name="TEXT">Honestly, neither am I, I have to teach you about the wonders of our world </field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="=I2v5%87Lo=:vN5OqM7}"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="wJel3bgek3kQb)B1_Cjb"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="x%CPbr{KH17}0}BN@jHD"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="gmdq~Rs;DkDMtw9GcKhN"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id="TLz!_#d10GsHb`busEOa"><field name="TEXT">using tools that harm it greatly.</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="%Bt#^k:QaI~RrUbcTcb="><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="-4$)_~r=7GNHx50(a#hY"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="p)N6$yEddLwyH6yC4(+`"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="WqIi,3XPHxqmdTbf?:Cx"><field name="VAR" id="KW/QBW*o]x9WQ)(y9Zg$">mySprite</field></block></value><value name="text"><shadow type="text" id="qPJtVS`)!9nM{RV4}sgH"><field name="TEXT">So why didn't you change it back?</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="pWs7IQh;Q)e}#[?$G)pP"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="54iqQn0?y`|Yb^]ss1s3"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id=":kCB?:FH|7pWcujh)C1d"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="Or_%xoMywe[^*s.D.AV|"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id="HnYfU*=Iw[KjBC0{0e(="><field name="TEXT">Believe me, I tried kiddo, but too many kids and teachers are already using it</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="A7!kDlaQ:c:#uxyxq-6("><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="I3xks]zv)=`aohT/}}^D"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="OmIq-$th[SNgs3?=]f^n"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="6aM!-tr{Ef~5~(Qj~!8*"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id="-kHhHPba(z^1iFyRzsxl"><field name="TEXT">I'm sorry, but hey, doesn;t mean you have to stop learning, and using that brain of yours for good things.</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="L4:o`-nGI.Kaz!_p}0^Q"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="g)DlN$[=|0r6YS3cx2)5"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id=",98|``RKk9KRNQP)mu/H"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="mm#Ow9[VY?}}X5E,}ch9"><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="text"><shadow type="text" id="arnZ2(que9)qEBuG5Ee#"><field name="TEXT">Now go get to class, hope you found all your books in time haha.</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="-.1{(Zqoq-(5/*O@~CaF"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="mKnZ$V#Ht~dQ%zf^UO8c"><field name="index">1</field></shadow></value><next><block type="hudChangeScoreBy" id="L{0KgBp%+;9bw,,50EEq"><value name="value"><shadow type="math_number" id=":P-e;;5;j5[eY;z4ueKM"><field name="NUM">1</field></shadow></value><next><block type="spritedestroy2" id=":`I=womUmFDXP/}?8gnK"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="sprite"><block type="variables_get" id="uCAo^UG1XL].xn4;)Vg("><field name="VAR" id="L[hC%T$ahiVfqq^:Vd=/">science</field></block></value><value name="duration"><shadow type="timePicker" id="TEV|m|,RA9^-.)K|d+7="><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next><