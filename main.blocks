peed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="SQ(=WW|y=3Ew|h/k2Nvs"><field name="VAR" id="bZ^xn:zIw(f?KFPlm(KD">librarian2</field></block></value><value name="text"><shadow type="text" id="g@LA+Fz(-6@)R0$Whn(("><field name="TEXT">That's because the books are getting packed away</field></shadow></value><next><block type="story_sprite_say_text" id="S4oOi|;r$1]~sNshCJ%o"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="OT@8T@MboXRCAsDT_PAE"><field name="VAR" id="KW/QBW*o]x9WQ)(y9Zg$">mySprite</field></block></value><value name="text"><shadow type="text" id="(uFaBki,|T_3?jrna2^#"><field name="TEXT">What!?</field></shadow></value><next><block type="story_sprite_say_text" id="@`SBylptHj1:xyV=Wy24"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="@f3]ah`V~vC=j/f`g-F]"><field name="VAR" id="bZ^xn:zIw(f?KFPlm(KD">librarian2</field></block></value><value name="text"><shadow type="text" id="[qczfG^fPAci*myHj|:{"><field name="TEXT">Unfortunately, the school is opting to focus on AI, which takes away the need for any real books... </field></shadow></value><next><block type="story_sprite_say_text" id="_Pj+/fqyl=+x,6xg{#,^"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="{ZFqmMky$fk9Zi;H2B3T"><field name="VAR" id="bZ^xn:zIw(f?KFPlm(KD">librarian2</field></block></value><value name="text"><shadow type="text" id="F67/mg^WN1.sOuzGXy?6"><field name="TEXT">You can try and find the other books in the classrooms, but be quick! Class starts soon</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="iqhD.[nkt)}#TJ6OnA.V"><field name="index">15</field></shadow></value><next><block type="story_sprite_say_text" id="?$P(c!Q1~|Xoai:YZShd"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="(/D:?q(FlN|$uD^HI4PB"><field name="VAR" id="bZ^xn:zIw(f?KFPlm(KD">librarian2</field></block></value><value name="text"><shadow type="text" id=".v6K:-;S[@9b|iHI|6|f"><field name="TEXT">Oh, and maybe try and convince those teachers to reconsider this AI stuff..</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="3hB%KP]Q{oqMdsi(_r2o"><field name="index">4</field></shadow></value><next><block type="music_stop_all_sounds" id="BV`Lk63($P6P9YN*`1e3"><next><block type="music_playable_play" id="BKa5o:`[Zzn-O`MjX1)K"><field name="playbackMode">music.PlaybackMode.LoopingInBackground</field><value name="toPlay"><shadow type="music_song_field_editor" id="n/^UlgXpiD%7v`#+D]DQ"><field name="song">hex``</field><data>{"commentRefs":[],"fieldData":{"song":null}}</data></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></next></block></statement><next><block type="variables_set" id="?-UbH(+M9@|V]/*y8HXI"><field name="VAR" id="efwS[,-g%1^/Y3}I#tpk">english</field><value name="VALUE"><shadow type="math_number" id="1~]Y3!xo!7G4gyNL-b@)"><field name="NUM">0</field></shadow><block type="spritescreate" id="yhqm3U]/rciv5hnhdEb!"><value name="img"><shadow type="screen_image_picker" id="_G:?B{#6`y|9oXE~pXL0"><field name="img">img`
