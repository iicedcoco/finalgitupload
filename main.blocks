/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="fOoz:s=;:G9Y4eeQM^l1"><field name="VAR" id="KW/QBW*o]x9WQ)(y9Zg$">mySprite</field></block></value><value name="text"><shadow type="text" id="43=kbIQBAVvNEd~?NEz6"><field name="TEXT">but I heard that we won't really be using them this term?</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="ged[@e:p7D0QlzQAKP@n"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="%F`9qLp,AxXV8~4.R9f8"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="(74q^lT-A[Y]9s+Hx2?W"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="ZDPjp2R2S*4uDH:V:Kbu"><field name="VAR" id="^@zgsSggLWNLHu]I]tt0">math</field></block></value><value name="text"><shadow type="text" id="cb@h88qjqf#o6RiO2lgu"><field name="TEXT">Right you are! We will be teaching you all how to utilise</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="4:im]s+-4n)]-l|fjLfJ"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="H]b.om%mSPqjo#u7~OtL"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id=".@Cy@t_W:$;b9I4.k`nF"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="skY8!N1HTy*)QHZoaj/+"><field name="VAR" id="^@zgsSggLWNLHu]I]tt0">math</field></block></value><value name="text"><shadow type="text" id="JdV!{ot,_F9+/zZ,AHMI"><field name="TEXT">These new tech tools to make maths even simpler</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="]5Bue=/9?qC3=)@WgRtY"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="3VH:)PXjYYw`)zR$-gFj"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="%xG(9#k-)D[n2!J8gQ/f"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="rEU+Uh$Y]}X0sm@X09cM"><field name="VAR" id="KW/QBW*o]x9WQ)(y9Zg$">mySprite</field></block></value><value name="text"><shadow type="text" id="J8rseqFYZV[+BArfdP=g"><field name="TEXT">But wouldn't that just be doing the work for you</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="l6J;m2^I]FqDwU=$b~RH"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="JED4laZP4oD5;/;uoLJ]"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="]P7Az4,IH_t`1ZpqGf+n"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="Hirr}`JYz3;%p86_%v+]"><field name="VAR" id="^@zgsSggLWNLHu]I]tt0">math</field></block></value><value name="text"><shadow type="text" id="=80ZtWl-tlUcH8.}92-_"><field name="TEXT">Haha, I'm not sure why you sound upset at that</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="FH{tut8N1|rsoV_.8wqk"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="2=@7VLZ+)a,Zs}I5tn^k"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="|%JnP~{|XDPMHdmJOf[_"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><va