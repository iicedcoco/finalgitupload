eld name="index">0</field></shadow></value></block></value><next><block type="arcade_story_start_cutscene" id="{Hd12F]7c9f#btGRc#OV"><statement name="HANDLER"><block type="story_set_sound_enabled" id="ZGP@1i35!3n*mzZPLHKo"><value name="enabled"><shadow type="logic_boolean" id="r[yp1~eH7r4vyV/qvLD6"><field name="BOOL">TRUE</field></shadow></value><next><block type="story_sprite_say_text" id="d?_5WWz/.n3zF{uqju{p"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="tSn[c8Yv@2paZ@n)})xv"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="D!I,,0);_k5X^)B3/c2;"><field name="TEXT">AI is quickly taking over schools and workplaces</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="+Qu:5FbXWOOpP2SBJX%#"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id=").A]p}`?#(hWcD$KXI`f"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="fs}NU.2YDxM7_L0dUKOL"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="+v6mg!3Sove[$L^t8Ac="><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="Mns^A!yX.Hlg.W~{[7aj"><field name="TEXT">However, it is most often used as a way to cognitively off load</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="}f#wi{P[W[HbhJCM9HRb"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="@Aa(t]JhYD~7zTTf1[XA"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="h*N:8Y}lFci#|OaEj!+a"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="vp2H$8AACvzX}-LqA+jz"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="pCKNR[.Z-3t.B1$Ekv}Y"><field name="TEXT">Putting convenience before the things that make us human</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="A`tO~)FKyBm,MMsUk:o~"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="g+C^F9iB4ZU[!osk3:,$"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="?F)KQ4~0nLfMO!EF6j+C"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="]ZlI%67.UcxYQcE:VW_g"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id=":TXTE]=#Om!;Ak8`CY@K"><field name="TEXT">That keep our brains healthy</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="KyUTEB;w~viOF?bN)]LA"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="J8@ni`wcBdaJf:4(L-EM"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="EDOL^K%e~(TLtGShdp2:"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="?|)}OU$mIk,vxxTJt4]a"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id=";Ps1BeI20m%cB=c1[/nT"><field name="TEXT">And in doing so, we are also harming our planet</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="NAO!:PJ8hTYmq4v1Sa*J"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id=")|xx`bl`L5bP9laQtXh="><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id=":0J:P$=a%a/0{l#J)C}r"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id=".]5?e@KO_GM!!;0_c;U*"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="!~v]Sg[1#@KS}v;6Ds+~"><field name="TEXT">AI is everywhere, can be used for everything</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="u?WzYU~p/]Ij`YZM~O{U"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="b]v2(i{,jE!0jVG+?21n"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="H[:IoMk|dM80jmeb3DBE"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="g^}]H4hbqAp0Cs07:~Ak"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="EVjyWbJ$kJ^NTq#aV-ID"><field name="TEXT">But AI is no one, it is a mixture of everyone and it doesn't not represent you</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="C(5rVR~,D)IY~?)uU5f%"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="cl)w(pNyy,}eYUlS;{OL"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="NU*mz`*`.Gsw#i4,7)Yt"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="tP1F`f:R;UYOC}~rE;+R"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="a!O{sI[rVkyO_]^EMzgy"><field name="TEXT">This game was a project driven by passion, made by hand</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="aoj5z^Emous9:{*X1,10"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="/@A%BrDcmfwaK6e(V{?v"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="~DVhWkyO:v}j:@dQYXP="><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="J1^VQO29+#@%NVZI+?d6"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="fY_~spNkKhF@C9^bq!YK"><field name="TEXT">It involved learning along the way and makes it a human experience</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="[F#W+xH,8*EP/FO~,3Nz"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="4zGZ2Vj_=5nyJd^)QR^f"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="b+f=-!oYq[5,R/(ZfV.)"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="Ak#63`i`Kar*hqh0Y:-f"><field name="VAR" id="^8utHiB:D9)kNR;y@%(Q">textSprite2</field></block></value><value name="text"><shadow type="text" id="QQ:2Wg;c%13)(]S@;Ld+"><field name="TEXT">So next time you have to create something</field></shadow></value><value name="foreground"><shadow type="colorindexpicker