tp://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="[V863w[QVNJG(I=hFVgn"><field name="VAR" id="KW/QBW*o]x9WQ)(y9Zg$">mySprite</field></block></value><value name="text"><shadow type="text" id="rozOiDVG6(`s{OzDy`Jr"><field name="TEXT">Uh, Yes! I am.. but is it true we are really going to be using AI in class?</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="U^;@]$;MvX4qc50EzLOh"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="-v!i{wr[ZyhzamVfgSl1"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="dz[~oo,1`;Ncfb.tjfm7"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id=";d}H5y~vJ|{H?y4M3_2*"><field name="VAR" id="efwS[,-g%1^/Y3}I#tpk">english</field></block></value><value name="text"><shadow type="text" id="5Z;PH$!GDO0,=87)3U3M"><field name="TEXT">Ah, well yes, don't go thinking it means you can use it for everything..</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="KMZ$YrsY8]X{s]:~ARy?"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="Lq3?xwU;N/Iz%~r%@{xI"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="XRm4_8]uO/Cg0uwju0*}"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="FnY13^^|!o`I]hqhIp.["><field name="VAR" id="efwS[,-g%1^/Y3}I#tpk">english</field></block></value><value name="text"><shadow type="text" id="auvIMFJp,q1(EcDV,@m3"><field name="TEXT">but we have to keep up with you kids.</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="t1(%HTdnM2?B=.u+{}zu"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="Ymps$unO(UY6T](T.[wd"><field name="index">1</field></shadow></value><next><block type="story_sprite_say_text" id="0]S+lpI`o3Dq[45XbXEr"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="speed">story.TextSpeed.VerySlow</field><value name="sprite"><block type="variables_get" id="H1TaMv3XcVWDBI|d,HP,"><field name="VAR" id="efwS[,-g%1^/Y3}I#tpk">english</field></block></value><value name="text"><shadow type="text" id="6zfMpekcDJb^CAilq-D3"><field name="TEXT">And, it is quite convenient for me as well.</field></shadow></value><value name="foreground"><shadow type="colorindexpicker" id="3ngi53`:?pThP[S)OooS"><field name="index">15</field></shadow></value><value name="background"><shadow type="colorindexpicker" id="OJ?aj5_c]+m]+EY[~jqI"><field name="index">1</field></shadow></value><next><block type="hudChangeScoreBy" id="!x?m./X//K}We@/vlzn#"><value name="value"><shadow type="math_number" id="K;H;@%]S@;pxF=w7Z*xu"><field name="NUM">1</field></shadow></value><next><block type="spritedestroy2" id="O).^YvXM!F,]Wj|Yz:1c"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><field name="effect">effects.spray</field><value name="sprite"><block type="variables_get" id="vPy|38U7$^KGcEi2~`_z"><field name="VAR" id="efwS[,-g%1^/Y3}I#tpk">english</field></block></value><value name="duration"><shadow type="timePicker" id="pk[4XhpQp[T71RdOPBRh"><field name="ms">500</field></shadow></value></block></next></block></next></block></next></block></next></block></next></block></next></block></statement></block><block type="spritesoverlap" id="=4rp?Q!P*wul1f8}oUWM" x="1376" y="1443"><value name="HANDLER_DRAG_PARAM_sprite"><block type="argument_reporter_custom" id="Q}C@PU{fRa[rZ)OPDBT5" del